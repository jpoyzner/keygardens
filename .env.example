# Copy this file to .env.local for local development and fill in real values.
# The same names must be added as Environment Variables on the Vercel project (Settings > Environment Variables).

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Checkout + Connect) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
